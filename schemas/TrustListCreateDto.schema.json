{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./TrustListCreateDto.schema.json",
  "title": "TrustListCreateDto",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "description": "The full trust list JSON (generated LoTE structure)"
    },
    "entities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "./InternalTrustListEntity.schema.json"
          },
          {
            "$ref": "./ExternalTrustListEntity.schema.json"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "internal": "./InternalTrustListEntity.schema.json",
            "external": "./ExternalTrustListEntity.schema.json"
          }
        },
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "internal",
              "external"
            ]
          }
        }
      }
    },
    "id": {
      "type": "string"
    },
    "keyChainId": {
      "type": "string"
    }
  },
  "required": [
    "entities"
  ],
  "additionalProperties": false
}