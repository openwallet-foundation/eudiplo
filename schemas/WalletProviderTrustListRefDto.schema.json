{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./WalletProviderTrustListRefDto.schema.json",
  "title": "WalletProviderTrustListRefDto",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "verifierKey": {
      "type": "object",
      "additionalProperties": true,
      "description": "JWK used to verify the trust-list JWT signature."
    },
    "verifierX509Der": {
      "type": "string",
      "description": "Base64 DER-encoded X.509 certificate used to verify the trust-list JWT signature."
    }
  },
  "required": [
    "url"
  ],
  "anyOf": [
    {
      "required": [
        "verifierKey"
      ]
    },
    {
      "required": [
        "verifierX509Der"
      ]
    }
  ],
  "additionalProperties": false
}