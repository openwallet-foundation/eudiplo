{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable or disable automatic key rotation."
    },
    "intervalDays": {
      "description": "Rotation interval in days.",
      "type": "number",
      "minimum": 1,
      "maximum": 3650
    },
    "certValidityDays": {
      "description": "Certificate validity period in days for generated leaf certificates.",
      "type": "number",
      "minimum": 1,
      "maximum": 3650
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false,
  "$id": "./RotationPolicyCreateDto.schema.json",
  "title": "RotationPolicyCreateDto"
}
