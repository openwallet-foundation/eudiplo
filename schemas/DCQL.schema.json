{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./DCQL.schema.json",
  "title": "DCQL",
  "type": "object",
  "properties": {
    "credentials": {
      "type": "array",
      "description": "Format-discriminated credential queries.",
      "items": {
        "oneOf": [
          {
            "$ref": "./CredentialQueryDcSdJwt.schema.json"
          },
          {
            "$ref": "./CredentialQueryMsoMdoc.schema.json"
          }
        ],
        "discriminator": {
          "propertyName": "format",
          "mapping": {
            "dc+sd-jwt": "./CredentialQueryDcSdJwt.schema.json",
            "mso_mdoc": "./CredentialQueryMsoMdoc.schema.json"
          }
        },
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "dc+sd-jwt",
              "mso_mdoc"
            ]
          }
        }
      }
    },
    "credential_sets": {
      "type": "array",
      "items": {
        "$ref": "./CredentialSetQuery.schema.json"
      }
    }
  },
  "additionalProperties": false
}