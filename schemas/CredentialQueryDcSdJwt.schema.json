{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./CredentialQueryDcSdJwt.schema.json",
  "title": "CredentialQueryDcSdJwt",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "default": "dc+sd-jwt",
      "enum": [
        "dc+sd-jwt"
      ],
      "description": "Credential format discriminator."
    },
    "claim_sets": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Ordered alternative claim combinations for this credential query."
    },
    "trusted_authorities": {
      "type": "array",
      "description": "Trusted authority constraints (discriminated by type) for this credential query.",
      "items": {
        "oneOf": [
          {
            "$ref": "./TrustedAuthorityQueryEtsiTl.schema.json"
          },
          {
            "$ref": "./TrustedAuthorityQueryOpenIdFederation.schema.json"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "etsi_tl": "./TrustedAuthorityQueryEtsiTl.schema.json",
            "openid_federation": "./TrustedAuthorityQueryOpenIdFederation.schema.json"
          }
        },
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "etsi_tl",
              "openid_federation"
            ]
          }
        }
      }
    },
    "meta": {
      "description": "dc+sd-jwt schema metadata for the requested credential.",
      "allOf": [
        {
          "$ref": "./DcSdJwtCredentialQueryMeta.schema.json"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./ClaimsQuery.schema.json"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "multiple": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "meta",
    "id"
  ],
  "additionalProperties": false
}