{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./PolicyCredential.schema.json",
  "title": "PolicyCredential",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "$ref": "./ClaimsQuery.schema.json"
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "credential_sets": {
      "type": "array",
      "items": {
        "$ref": "./CredentialSetQuery.schema.json"
      }
    }
  },
  "required": [
    "credentials"
  ],
  "additionalProperties": false
}