{
  "apiVersion": "eudiplo.io/issuance-config/v2",
  "kind": "IssuanceConfig",
  "metadata": {
    "id": "issuance",
    "generation": 1
  },
  "spec": {
    "authorizationServers": [
      {
        "id": "issuer-built-in",
        "type": "built-in",
        "walletAttestationRequired": true
      }
    ],
    "batchSize": 10,
    "dPopRequired": true,
    "credentialResponseEncryption": true,
    "credentialRequestEncryption": true,
    "display": [
      {
        "locale": "en-US",
        "name": "HAIP Test Issuer",
        "logo": {
          "uri": "company.png"
        }
      }
    ],
    "walletProviderTrustLists": [
      {
        "trustListId": "oidf-wallet-providers"
      }
    ]
  }
}
