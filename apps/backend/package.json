        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.27",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.43",
        "@testcontainers/postgresql": "^12.0.4",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/k6": "^2.0.0",
        "@types/multer": "^2.1.0",
        "@types/node": "^26.0.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.9",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "nock": "^14.0.16",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.4",
        "ts-loader": "^9.6.2",
