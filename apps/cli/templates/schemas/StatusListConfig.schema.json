{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capacity": {
      "description": "Default status list capacity.",
      "type": "integer",
      "minimum": 100,
      "maximum": 9007199254740991
    },
    "bits": {
      "description": "Bits-per-status setting (1, 2, 4, or 8).",
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 8
        }
      ]
    },
    "ttl": {
      "description": "JWT TTL for status list tokens in seconds.",
      "type": "integer",
      "minimum": 60,
      "maximum": 9007199254740991
    },
    "immediateUpdate": {
      "description": "Regenerate status list JWTs immediately after status updates.",
      "type": "boolean"
    },
    "enableAggregation": {
      "description": "Include aggregation_uri in generated status list JWTs.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "description": "Tenant defaults for status list generation and publishing behavior.",
  "$id": "./StatusListConfig.schema.json",
  "title": "StatusListConfig"
}
