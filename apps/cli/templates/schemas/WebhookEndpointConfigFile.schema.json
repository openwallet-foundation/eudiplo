{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./WebhookEndpointConfigFile.schema.json",
  "title": "WebhookEndpointConfigFile",
  "description": "A webhook-endpoint configuration file in legacy payload or versioned-envelope form.",
  "oneOf": [
    {
      "$ref": "./CreateWebhookEndpointDto.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "eudiplo.io/webhook-endpoint/v1"
        },
        "kind": {
          "type": "string",
          "const": "WebhookEndpoint"
        },
        "metadata": {
          "$ref": "./ConfigDocumentMetadata.schema.json"
        },
        "spec": {
          "$ref": "./CreateWebhookEndpointDto.schema.json"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    }
  ]
}
