{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./IssuanceConfigFile.schema.json",
  "title": "IssuanceConfigFile",
  "description": "An issuance configuration file in legacy payload or versioned-envelope form.",
  "oneOf": [
    {
      "$ref": "./IssuanceConfig.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "eudiplo.io/issuance-config/v2"
        },
        "kind": {
          "type": "string",
          "const": "IssuanceConfig"
        },
        "metadata": {
          "$ref": "./ConfigDocumentMetadata.schema.json"
        },
        "spec": {
          "$ref": "./IssuanceConfig.schema.json"
        }
      },
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": false
    }
  ]
}
