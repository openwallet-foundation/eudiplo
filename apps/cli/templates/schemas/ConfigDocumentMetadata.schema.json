{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./ConfigDocumentMetadata.schema.json",
  "title": "ConfigDocumentMetadata",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable resource identifier."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing configuration generation."
    },
    "ownership": {
      "type": "string",
      "enum": ["unmanaged", "file-managed"],
      "description": "Requested ownership recorded when the document is applied."
    }
  },
  "required": ["id"],
  "additionalProperties": false
}
